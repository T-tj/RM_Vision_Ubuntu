{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build", // 对应 launch.json 里的 preLaunchTask
            "type": "shell",
            "command": "./build.sh",
            "options": {
                "cwd": "${workspaceFolder}" // 明确指定在 cpp_test 文件夹下执行
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}